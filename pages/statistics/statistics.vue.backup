<template>
	<view class="page">
		<view class="container">
			<!-- 时间筛选 -->
			<view class="filter-wrapper">
				<view class="time-filter">
					<view 
						class="filter-item" 
						v-for="(item, index) in data.timeFilters" 
						:key="index"
						:class="{ 'active': data.currentFilter === item.value }"
						@click="changeFilter(item.value)"
					>
						{{ item.label }}
					</view>
				</view>
			</view>
		
		<!-- 收支总览 -->
		<view class="overview-card">
			<view class="overview-header">
				<view class="overview-title-wrapper">
					<text class="overview-title">收支总览</text>
					<text class="overview-subtitle">{{ getFilterLabel() }}数据</text>
				</view>
				<!-- 生成海报按钮 - 移到右上角 -->
				<view class="poster-btn-mini" v-if="data.billCount > 0" @click="generatePoster">
					<text class="poster-icon-mini">📸</text>
				</view>
			</view>
			<view class="overview-row">
				<view class="overview-item income-item">
					<text class="overview-label">总收入</text>
					<text class="overview-amount income-color">+¥{{ data.totalIncome.toFixed(2) }}</text>
				</view>
				<view class="overview-item expense-item">
					<text class="overview-label">总支出</text>
					<text class="overview-amount expense-color">-¥{{ data.totalExpense.toFixed(2) }}</text>
				</view>
			</view>
			<view class="overview-divider"></view>
			<view class="overview-row balance-row">
				<view class="overview-item">
					<text class="overview-label">结余</text>
					<text class="overview-amount" :class="data.balance >= 0 ? 'income-color' : 'expense-color'">
						{{ data.balance >= 0 ? '+' : '' }}¥{{ Math.abs(data.balance).toFixed(2) }}
					</text>
				</view>
				<view class="overview-item">
					<text class="overview-label">笔数</text>
					<text class="overview-count">{{ data.billCount }}</text>
				</view>
			</view>
		</view>
		
		<!-- 类型切换 -->
		<view class="type-tabs">
			<view 
				class="type-tab" 
				:class="{ 'active': data.currentType === 'expense' }"
				@click="switchType('expense')"
			>
				<text class="tab-icon">💸</text>
				<text class="tab-text">支出分析</text>
			</view>
			<view 
				class="type-tab" 
				:class="{ 'active': data.currentType === 'income' }"
				@click="switchType('income')"
			>
				<text class="tab-icon">💰</text>
				<text class="tab-text">收入分析</text>
			</view>
		</view>
		
		<!-- 环形图 -->
		<view class="chart-card">
			<view class="card-title">{{ data.currentType === 'income' ? '收入' : '支出' }}构成</view>
			<view class="chart-wrapper" v-if="data.chartData.length > 0">
				<!-- 顶部标签 -->
				<view class="label-top" v-if="data.chartData[0]">
					<view class="label-dot" :style="{ backgroundColor: data.chartData[0].color }"></view>
					<view class="label-info">
						<text class="label-text">{{ data.chartData[0].icon }} {{ data.chartData[0].name }}</text>
						<text class="label-value">¥{{ data.chartData[0].amount.toFixed(0) }} ({{ data.chartData[0].percent }}%)</text>
					</view>
				</view>
				
				<view class="chart-row">
					<!-- 左侧标签 -->
					<view class="label-left" v-if="data.chartData[3]">
						<view class="label-dot" :style="{ backgroundColor: data.chartData[3].color }"></view>
						<view class="label-info">
							<text class="label-text">{{ data.chartData[3].icon }} {{ data.chartData[3].name }}</text>
							<text class="label-value">¥{{ data.chartData[3].amount.toFixed(0) }}</text>
							<text class="label-percent">{{ data.chartData[3].percent }}%</text>
						</view>
					</view>
					
					<!-- 中间图表 -->
					<view class="chart-center">
						<canvas 
							canvas-id="pieChart" 
							id="pieChart"
							class="chart-canvas"
							@touchstart="handleChartTouch"
						></canvas>
					</view>
					
					<!-- 右侧标签 -->
					<view class="label-right" v-if="data.chartData[1]">
						<view class="label-info">
							<text class="label-text">{{ data.chartData[1].icon }} {{ data.chartData[1].name }}</text>
							<text class="label-value">¥{{ data.chartData[1].amount.toFixed(0) }}</text>
							<text class="label-percent">{{ data.chartData[1].percent }}%</text>
						</view>
						<view class="label-dot" :style="{ backgroundColor: data.chartData[1].color }"></view>
					</view>
				</view>
				
				<!-- 底部标签 -->
				<view class="label-bottom" v-if="data.chartData[2]">
					<view class="label-dot" :style="{ backgroundColor: data.chartData[2].color }"></view>
					<view class="label-info">
						<text class="label-text">{{ data.chartData[2].icon }} {{ data.chartData[2].name }}</text>
						<text class="label-value">¥{{ data.chartData[2].amount.toFixed(0) }} ({{ data.chartData[2].percent }}%)</text>
					</view>
				</view>
			</view>
			<view class="chart-empty" v-else>
				<text class="empty-icon">📊</text>
				<text class="empty-text">暂无{{ data.currentType === 'income' ? '收入' : '支出' }}数据</text>
				<view class="empty-action" @click="goToHome">快去记账</view>
			</view>
		</view>
		
		<!-- 消费分析 -->
		<view class="analysis-card" v-if="data.insights.length > 0">
			<view class="card-title">财务分析</view>
			<view class="insights-list">
				<view 
					class="insight-item" 
					v-for="(insight, index) in data.insights" 
					:key="index"
					:class="insight.type"
				>
					<view class="insight-icon">{{ insight.icon }}</view>
					<view class="insight-content">
						<text class="insight-text">{{ insight.text }}</text>
						<text class="insight-tip" v-if="insight.tip">{{ insight.tip }}</text>
					</view>
				</view>
			</view>
		</view>
		</view>
	</view>
</template>

<script setup>
import { reactive, nextTick } from 'vue'
import { onLoad, onShow, onPullDownRefresh } from '@dcloudio/uni-app'
import billStorage from '@/utils/billStorage.js'

const data = reactive({
	currentFilter: 'month',
	currentType: 'expense', // 当前查看的类型：expense 或 income
	timeFilters: [
		{ label: '本月', value: 'month' },
		{ label: '本季', value: 'quarter' },
		{ label: '本年', value: 'year' }
	],
	totalExpense: 0,
	totalIncome: 0,
	balance: 0,
	billCount: 0,
	chartData: [],
	categories: [],
	colors: ['#52C41A', '#1890FF', '#FAAD14', '#F5222D', '#722ED1', '#13C2C2', '#EB2F96', '#FA8C16'],
	allBills: [], // 缓存所有账单数据
	insights: [] // 消费分析洞察
})

const handleBillSaved = async () => {
	console.log('统计页收到账单保存事件，立即刷新数据')
	try {
		// 强制从云端获取最新数据
		data.allBills = await billStorage.forceGetFromCloud()
		recalculateData()
		console.log('统计页数据刷新完成')
	} catch (error) {
		console.error('统计页刷新失败:', error)
	}
}

const changeFilter = async (value) => {
	if (data.currentFilter === value) return
	data.currentFilter = value
	
	// 显示加载提示
	uni.showLoading({ title: '加载中...' })
	
	try {
		// 强制从云端获取最新数据（忽略时间间隔限制）
		const bills = await billStorage.forceGetFromCloud()
		// 确保返回的是数组
		data.allBills = Array.isArray(bills) ? bills : []
		recalculateData()
	} catch (error) {
		console.error('获取数据失败:', error)
		// 出错时使用当前缓存数据
		recalculateData()
	} finally {
		uni.hideLoading()
	}
}

const switchType = (type) => {
	if (data.currentType === type) return
	data.currentType = type
	recalculateData()
	uni.vibrateShort({ type: 'light' })
}

const loadData = async () => {
	const bills = await billStorage.getBills({}, false) // 不允许后台同步
	data.allBills = bills // 缓存所有账单
	recalculateData()
}

const recalculateData = () => {
	// 确保 allBills 存在
	if (!data.allBills || !Array.isArray(data.allBills)) {
		data.allBills = []
		data.billCount = 0
		data.totalExpense = 0
		data.totalIncome = 0
		data.balance = 0
		data.chartData = []
		data.insights = []
		return
	}
	
	const filteredBills = filterBillsByTime(data.allBills)
	
	// 分别计算收入和支出
	const expenseBills = filteredBills.filter(bill => (bill.type || 'expense') === 'expense')
	const incomeBills = filteredBills.filter(bill => bill.type === 'income')
	
	data.billCount = filteredBills.length
	data.totalExpense = expenseBills.reduce((sum, bill) => sum + bill.amount, 0)
	data.totalIncome = incomeBills.reduce((sum, bill) => sum + bill.amount, 0)
	data.balance = data.totalIncome - data.totalExpense
	
	// 根据当前类型计算图表数据
	const targetBills = data.currentType === 'income' ? incomeBills : expenseBills
	calculateChartData(targetBills)
	generateInsights(targetBills)
	
	nextTick(() => {
		drawPieChart()
	})
}

const filterBillsByTime = (bills) => {
	const now = new Date()
	const currentYear = now.getFullYear()
	const currentMonth = now.getMonth()
	const currentQuarter = Math.floor(currentMonth / 3)
	
	return bills.filter(bill => {
		const billDate = new Date(bill.date)
		const billYear = billDate.getFullYear()
		const billMonth = billDate.getMonth()
		const billQuarter = Math.floor(billMonth / 3)
		
		switch (data.currentFilter) {
			case 'month':
				return billYear === currentYear && billMonth === currentMonth
			case 'quarter':
				return billYear === currentYear && billQuarter === currentQuarter
			case 'year':
				return billYear === currentYear
			default:
				return true
		}
	})
}

const calculateChartData = (bills) => {
	const categoryMap = {}
	const totalAmount = bills.reduce((sum, bill) => sum + bill.amount, 0)
	
	bills.forEach(bill => {
		if (!categoryMap[bill.categoryId]) {
			categoryMap[bill.categoryId] = 0
		}
		categoryMap[bill.categoryId] += bill.amount
	})
	
	// 先排序，再分配颜色
	const sortedData = Object.keys(categoryMap).map((id) => {
		const category = data.categories.find(c => c.id === parseInt(id)) || {}
		const amount = categoryMap[id]
		const percent = totalAmount > 0 ? Math.round((amount / totalAmount) * 100) : 0
		
		return {
			id: parseInt(id),
			name: category.name || '其他',
			icon: category.icon || '📦',
			amount,
			percent
		}
	}).sort((a, b) => b.amount - a.amount)
	
	// 排序后分配颜色
	data.chartData = sortedData.map((item, index) => ({
		...item,
		color: data.colors[index % data.colors.length]
	}))
}

const drawPieChart = () => {
	if (data.chartData.length === 0) {
		return
	}
	
	const ctx = uni.createCanvasContext('pieChart')
	const centerX = 80
	const centerY = 80
	const radius = 58
	
	let startAngle = -Math.PI / 2
	
	data.chartData.forEach((item, index) => {
		const angle = (item.percent / 100) * 2 * Math.PI
		const endAngle = startAngle + angle
		
		ctx.beginPath()
		ctx.moveTo(centerX, centerY)
		ctx.arc(centerX, centerY, radius, startAngle, endAngle)
		ctx.closePath()
		ctx.setFillStyle(item.color)
		ctx.fill()
		
		startAngle = endAngle
	})
	
	ctx.beginPath()
	ctx.arc(centerX, centerY, radius * 0.6, 0, 2 * Math.PI)
	ctx.setFillStyle('#FFFFFF')
	ctx.fill()
	
	ctx.setFontSize(10)
	ctx.setFillStyle('#999999')
	ctx.setTextAlign('center')
	ctx.fillText('总支出', centerX, centerY - 5)
	
	ctx.setFontSize(13)
	ctx.setFillStyle('#1A1A1A')
	ctx.fillText(`¥${data.totalExpense.toFixed(0)}`, centerX, centerY + 8)
	
	ctx.draw()
}

const handleChartTouch = () => {
	// 图表交互处理
}

const getLegendColor = (index) => {
	const colorList = ['#52C41A', '#1890FF', '#FAAD14', '#F5222D', '#722ED1', '#13C2C2', '#EB2F96', '#FA8C16']
	return colorList[index % colorList.length]
}

const goToHome = () => {
	uni.switchTab({
		url: '/pages/index/index'
	})
}

// 生成财务分析洞察（综合收入和支出）
const generateInsights = (bills) => {
	const insights = []
	
	// 如果没有账单，显示提示信息
	if (data.billCount === 0) {
		insights.push({
			type: 'info',
			icon: '📝',
			text: '还没有账单记录',
			tip: '快去记录第一笔账单吧'
		})
		data.insights = insights
		return
	}
	
	// 1. 收支平衡分析
	if (data.balance >= 0) {
		const savingRate = data.totalIncome > 0 ? Math.round((data.balance / data.totalIncome) * 100) : 0
		if (savingRate >= 30) {
			insights.push({
				type: 'success',
				icon: '🎉',
				text: `收支结余¥${data.balance.toFixed(2)}，储蓄率${savingRate}%`,
				tip: '财务状况优秀，继续保持！'
			})
		} else if (savingRate >= 10) {
			insights.push({
				type: 'success',
				icon: '✅',
				text: `收支结余¥${data.balance.toFixed(2)}，储蓄率${savingRate}%`,
				tip: '财务状况良好'
			})
		} else {
			insights.push({
				type: 'warning',
				icon: '⚡',
				text: `收支结余¥${data.balance.toFixed(2)}，储蓄率${savingRate}%`,
				tip: '建议提高储蓄比例'
			})
		}
	} else {
		insights.push({
			type: 'danger',
			icon: '🚨',
			text: `收支赤字¥${Math.abs(data.balance).toFixed(2)}`,
			tip: '支出超过收入，需要控制消费或增加收入'
		})
	}
	
	// 2. 收入/支出趋势分析（对比上期）
	if (data.currentFilter === 'month') {
		const lastPeriodBills = getLastPeriodBills()
		const lastIncome = lastPeriodBills.filter(b => b.type === 'income').reduce((sum, bill) => sum + bill.amount, 0)
		const lastExpense = lastPeriodBills.filter(b => (b.type || 'expense') === 'expense').reduce((sum, bill) => sum + bill.amount, 0)
		
		if (lastIncome > 0 || lastExpense > 0) {
			const incomeChange = lastIncome > 0 ? Math.round(((data.totalIncome - lastIncome) / lastIncome) * 100) : 0
			const expenseChange = lastExpense > 0 ? Math.round(((data.totalExpense - lastExpense) / lastExpense) * 100) : 0
			
			if (incomeChange > 10 && expenseChange < 10) {
				insights.push({
					type: 'success',
					icon: '📈',
					text: `收入增长${incomeChange}%，支出${expenseChange > 0 ? '增长' : '减少'}${Math.abs(expenseChange)}%`,
					tip: '财务状况向好发展'
				})
			} else if (expenseChange > 20) {
				insights.push({
					type: 'warning',
					icon: '⚠️',
					text: `支出增长${expenseChange}%，收入${incomeChange > 0 ? '增长' : '减少'}${Math.abs(incomeChange)}%`,
					tip: '支出增长过快，注意控制'
				})
			} else if (incomeChange < -10) {
				insights.push({
					type: 'warning',
					icon: '📉',
					text: `收入减少${Math.abs(incomeChange)}%，支出${expenseChange > 0 ? '增长' : '减少'}${Math.abs(expenseChange)}%`,
					tip: '收入下降，建议开源节流'
				})
			}
		}
	}
	
	// 3. 未来预测（基于当前趋势）
	const prediction = generatePrediction()
	if (prediction) {
		insights.push(prediction)
	}
	
	// 4. 分类占比分析
	if (data.chartData.length > 0) {
		const topCategory = data.chartData[0]
		const categoryType = data.currentType === 'income' ? '收入' : '支出'
		if (topCategory.percent >= 40) {
			insights.push({
				type: 'info',
				icon: '📊',
				text: `${topCategory.icon} ${topCategory.name}占${categoryType}${topCategory.percent}%`,
				tip: `${categoryType}来源${topCategory.percent >= 50 ? '过于' : '较为'}集中`
			})
		}
	}
	
	// 5. 预算对比（仅支出）
	if (data.currentFilter === 'month') {
		const budget = uni.getStorageSync('budget') || 6000
		if (data.totalExpense > budget) {
			const overPercent = Math.round(((data.totalExpense - budget) / budget) * 100)
			insights.push({
				type: 'danger',
				icon: '💸',
				text: `已超预算${overPercent}%，超支¥${(data.totalExpense - budget).toFixed(2)}`,
				tip: '建议减少非必要开支'
			})
		}
	}
	
	// 最多显示4条洞察
	data.insights = insights.slice(0, 4)
}

// 生成未来预测
const generatePrediction = () => {
	const lastPeriodBills = getLastPeriodBills()
	if (lastPeriodBills.length === 0) return null
	
	const lastIncome = lastPeriodBills.filter(b => b.type === 'income').reduce((sum, bill) => sum + bill.amount, 0)
	const lastExpense = lastPeriodBills.filter(b => (b.type || 'expense') === 'expense').reduce((sum, bill) => sum + bill.amount, 0)
	
	// 计算增长率
	const incomeGrowth = lastIncome > 0 ? (data.totalIncome - lastIncome) / lastIncome : 0
	const expenseGrowth = lastExpense > 0 ? (data.totalExpense - lastExpense) / lastExpense : 0
	
	// 预测下期
	const predictedIncome = data.totalIncome * (1 + incomeGrowth)
	const predictedExpense = data.totalExpense * (1 + expenseGrowth)
	const predictedBalance = predictedIncome - predictedExpense
	
	let periodText = ''
	if (data.currentFilter === 'month') {
		periodText = '下月'
	} else if (data.currentFilter === 'quarter') {
		periodText = '下季度'
	} else {
		periodText = '明年'
	}
	
	if (predictedBalance < 0) {
		return {
			type: 'warning',
			icon: '🔮',
			text: `预测${periodText}可能赤字¥${Math.abs(predictedBalance).toFixed(0)}`,
			tip: '建议提前规划，控制支出或增加收入'
		}
	} else if (predictedBalance < data.balance * 0.5) {
		return {
			type: 'warning',
			icon: '🔮',
			text: `预测${periodText}结余¥${predictedBalance.toFixed(0)}，较本期下降`,
			tip: '财务状况可能恶化，需要注意'
		}
	} else {
		return {
			type: 'success',
			icon: '🔮',
			text: `预测${periodText}结余¥${predictedBalance.toFixed(0)}`,
			tip: '财务状况预计保持良好'
		}
	}
}

// 获取上期账单（用于对比）
const getLastPeriodBills = () => {
	const now = new Date()
	const currentYear = now.getFullYear()
	const currentMonth = now.getMonth()
	
	// 计算上月
	let lastYear = currentYear
	let lastMonth = currentMonth - 1
	if (lastMonth < 0) {
		lastMonth = 11
		lastYear = currentYear - 1
	}
	
	return data.allBills.filter(bill => {
		const billDate = new Date(bill.date)
		const billYear = billDate.getFullYear()
		const billMonth = billDate.getMonth()
		return billYear === lastYear && billMonth === lastMonth
	})
}

const getFilterLabel = () => {
	const labels = {
		'month': '本月',
		'quarter': '本季',
		'year': '本年'
	}
	return labels[data.currentFilter] || '本月'
}

const generatePoster = () => {
	if (data.billCount === 0) {
		uni.showToast({
			title: '暂无数据',
			icon: 'none'
		})
		return
	}
	
	// 准备海报数据
	const posterData = {
		filterType: data.currentFilter,
		filterLabel: getFilterLabel(),
		totalExpense: data.totalExpense,
		billCount: data.billCount,
		topCategories: data.chartData.slice(0, 3).map(item => ({
			name: item.name,
			icon: item.icon,
			amount: item.amount,
			percent: item.percent,
			color: item.color
		}))
	}
	
	// 跳转到海报页面
	uni.navigateTo({
		url: `/subPackages/record/poster/index?data=${encodeURIComponent(JSON.stringify(posterData))}`
	})
}

onLoad(() => {
	data.categories = uni.getStorageSync('categories') || []
	loadData()
	
	// 监听账单保存事件
	uni.$on('billSaved', handleBillSaved)
	
	// 首次加载后，后台静默同步一次云端数据
	setTimeout(async () => {
		const bills = await billStorage.getBills({}, true)
		if (bills.length !== data.allBills.length) {
			// 如果数据有变化，重新计算
			data.allBills = bills
			recalculateData()
		}
	}, 1000)
})

onShow(() => {
	// 检查是否需要刷新数据
	const needRefresh = uni.getStorageSync('needRefreshStatistics')
	
	if (needRefresh) {
		// 清除标记
		uni.removeStorageSync('needRefreshStatistics')
		// 立即显示加载提示
		uni.showLoading({ title: '刷新中...' })
		// 强制从云端获取最新数据并刷新
		billStorage.forceGetFromCloud().then(bills => {
			data.allBills = bills
			recalculateData()
			uni.hideLoading()
		}).catch(error => {
			console.error('刷新失败:', error)
			// 即使失败也尝试从本地加载
			loadData()
			uni.hideLoading()
		})
	} else if (!data.allBills || data.allBills.length === 0) {
		// 如果缓存为空（比如首次进入），也加载数据
		loadData()
	}
})

// 下拉刷新
onPullDownRefresh(async () => {
	try {
		// 确保至少显示500ms的刷新动画
		const startTime = Date.now()
		
		// 强制从云端获取最新数据
		data.allBills = await billStorage.forceGetFromCloud()
		recalculateData()
		
		const elapsedTime = Date.now() - startTime
		const remainingTime = Math.max(0, 500 - elapsedTime)
		
		setTimeout(() => {
			uni.stopPullDownRefresh()
		}, remainingTime)
	} catch (error) {
		console.error('刷新失败:', error)
		uni.stopPullDownRefresh()
	}
})
</script>

<style lang="scss" scoped>
	@import "@/styles/variables.scss";
	
	.page {
