	.container {
		min-height: 100vh;
		background: linear-gradient(180deg, #F0FFF4 0%, #F6FFED 50%, #FAFAFA 100%);
		padding: $spacing-sm $spacing-md;
		padding-bottom: 100rpx;
		box-sizing: border-box;
	}
	
	/* 筛选器包装容器 */
